  "/debate/multi-agent": {
   "post": {
    "description": "Runs the original Advocate -> Skeptic -> Synthesizer pipeline explicitly.\nNot the default (see POST /debate) -- kept reachable because it's the\neval harness's (run_phase6.py) subject; the comparison against\nsingle_call only means something if this keeps running under the same\nconditions it was measured under. Expected latency: ~74 seconds.\nNot cached, unlike /debate, so eval runs always get a fresh pass.",
    "operationId": "debate_multi_agent_debate_multi_agent_post",
    "requestBody": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/DebateRequest"
