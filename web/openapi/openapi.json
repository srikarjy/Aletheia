  "/debate": {
   "post": {
    "description": "Synchronous debate endpoint. Runs single_call: real retrieval + one\nrubric-anchored Claude call (see app/agents/single_call.py's module\ndocstring for why this is the default over the multi-agent pipeline).\nUses caching for repeated claims.",
    "operationId": "debate_sync_debate_post",
    "requestBody": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/DebateRequest"
       }
      }
     },
     "required": true
    },
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/DebateResponse"
        }
       }
      },
      "description": "Successful Response"
     },
     "422": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      },
      "description": "Validation Error"
     }
    },
    "security": [
     {
      "HTTPBearer": []
     }
    ],
    "summary": "Debate Sync"
   }
  },
  "/debate/async": {
   "post": {
    "description": "Asynchronous debate endpoint. Submits job to background queue and returns job ID.\nPoll /debate/jobs/{job_id} for status. Better for production use.",
