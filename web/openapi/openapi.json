{
 "components": {
  "schemas": {
   "AsyncDebateRequest": {
    "properties": {
     "async_mode": {
      "default": false,
      "title": "Async Mode",
      "type": "boolean"
     },
     "claim": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Claim",
      "type": "string"
     },
     "multi_agent": {
      "default": false,
      "title": "Multi Agent",
      "type": "boolean"
     }
    },
    "required": [
     "claim"
    ],
    "title": "AsyncDebateRequest",
    "type": "object"
   },
   "BatchJobResponse": {
    "properties": {
     "batch_id": {
      "title": "Batch Id",
      "type": "string"
     },
     "completed": {
      "title": "Completed",
      "type": "integer"
     },
     "failed": {
      "title": "Failed",
      "type": "integer"
     },
     "results": {
      "default": [],
      "items": {
       "additionalProperties": true,
       "type": "object"
      },
      "title": "Results",
      "type": "array"
     },
     "status": {
      "title": "Status",
      "type": "string"
     },
     "total_claims": {
      "title": "Total Claims",
      "type": "integer"
     }
    },
    "required": [
     "batch_id",
     "status",
     "total_claims",
     "completed",
     "failed"
    ],
    "title": "BatchJobResponse",
    "type": "object"
   },
   "BatchRequest": {
    "properties": {
     "async_mode": {
      "default": true,
      "title": "Async Mode",
      "type": "boolean"
     },
     "claims": {
      "items": {
       "maxLength": 500,
       "minLength": 1,
       "type": "string"
      },
      "title": "Claims",
      "type": "array"
     }
    },
    "required": [
     "claims"
    ],
    "title": "BatchRequest",
    "type": "object"
   },
   "DebateRequest": {
    "properties": {
     "claim": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Claim",
      "type": "string"
     }
    },
    "required": [
     "claim"
    ],
    "title": "DebateRequest",
    "type": "object"
   },
   "DebateResponse": {
    "properties": {
     "claim": {
      "title": "Claim",
      "type": "string"
     },
     "conclusion": {
      "title": "Conclusion",
      "type": "string"
     },
     "confidence": {
      "title": "Confidence",
      "type": "number"
     },
     "confidence_rationale": {
      "title": "Confidence Rationale",
      "type": "string"
     },
     "debate_id": {
      "format": "uuid",
      "title": "Debate Id",
      "type": "string"
     },
     "driving_provenance_ids": {
      "items": {
       "type": "integer"
      },
      "title": "Driving Provenance Ids",
      "type": "array"
     },
     "signal_breakdown": {
      "anyOf": [
       {
        "$ref": "#/components/schemas/SignalBreakdown"
       },
       {
        "type": "null"
       }
      ]
     },
     "sources": {
      "items": {
       "$ref": "#/components/schemas/Source"
      },
      "title": "Sources",
      "type": "array"
     },
     "transcript": {
      "items": {
       "$ref": "#/components/schemas/TranscriptEntry"
      },
      "title": "Transcript",
      "type": "array"
     },
     "verdict": {
      "title": "Verdict",
      "type": "string"
     }
    },
    "required": [
     "debate_id",
     "claim",
     "conclusion",
     "verdict",
     "confidence",
     "confidence_rationale",
     "driving_provenance_ids",
     "transcript",
     "sources"
    ],
    "title": "DebateResponse",
    "type": "object"
   },
   "HTTPValidationError": {
    "properties": {
     "detail": {
      "items": {
       "$ref": "#/components/schemas/ValidationError"
      },
      "title": "Detail",
      "type": "array"
     }
    },
    "title": "HTTPValidationError",
    "type": "object"
   },
   "JobStatusResponse": {
    "properties": {
     "cache_hit": {
      "default": false,
      "title": "Cache Hit",
      "type": "boolean"
     },
     "completed_at": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "title": "Completed At"
     },
     "created_at": {
      "title": "Created At",
      "type": "number"
     },
     "debate_id": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Debate Id"
     },
     "error": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Error"
     },
     "job_id": {
      "title": "Job Id",
      "type": "string"
     },
     "result": {
      "anyOf": [
       {
        "$ref": "#/components/schemas/DebateResponse"
       },
       {
        "type": "null"
       }
      ]
     },
     "started_at": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "title": "Started At"
     },
     "status": {
      "title": "Status",
      "type": "string"
     }
    },
    "required": [
     "job_id",
     "status",
     "created_at"
    ],
    "title": "JobStatusResponse",
    "type": "object"
   },
   "SignalBreakdown": {
    "description": "Per-evidence-type support scores from single_call, each scored only\nfrom evidence types actually present in that call's retrieval (0.0 for an\nabsent type). Additive to the rubric-v1 scalar `confidence`, which is\nunchanged \u2014 this exists so a frontend can render four honest bars instead\nof faking four from one number. None on the multi-agent path, whose\nsynthesizer predates (and, as the frozen eval subject, doesn't adopt)\nthis field.",
    "properties": {
     "clinical_evidence": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Clinical Evidence",
      "type": "number"
     },
     "literature": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Literature",
      "type": "number"
     },
     "llm_rating": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Llm Rating",
      "type": "number"
     },
     "protein_evidence": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Protein Evidence",
      "type": "number"
     }
    },
    "required": [
     "literature",
     "protein_evidence",
     "clinical_evidence",
     "llm_rating"
    ],
    "title": "SignalBreakdown",
    "type": "object"
   },
   "Source": {
    "properties": {
     "concern": {
      "default": false,
      "title": "Concern",
      "type": "boolean"
     },
     "paper_id": {
      "title": "Paper Id",
      "type": "string"
     },
     "retracted": {
      "default": false,
      "title": "Retracted",
      "type": "boolean"
     },
     "retraction_notice": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Retraction Notice"
     },
     "title": {
      "title": "Title",
      "type": "string"
     },
     "used_by": {
      "items": {
       "type": "string"
      },
      "title": "Used By",
      "type": "array"
     }
    },
    "required": [
     "paper_id",
     "title",
     "used_by"
    ],
    "title": "Source",
    "type": "object"
   },
   "TranscriptEntry": {
    "properties": {
     "action": {
      "title": "Action",
      "type": "string"
     },
     "agent": {
      "title": "Agent",
      "type": "string"
     },
     "detail": {
      "additionalProperties": true,
      "title": "Detail",
      "type": "object"
     },
     "source_paper_id": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Source Paper Id"
     }
    },
    "required": [
     "agent",
     "action",
     "detail"
    ],
    "title": "TranscriptEntry",
    "type": "object"
   },
   "ValidationError": {
    "properties": {
     "ctx": {
      "title": "Context",
      "type": "object"
     },
     "input": {
      "title": "Input"
     },
     "loc": {
      "items": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "integer"
        }
       ]
      },
      "title": "Location",
      "type": "array"
     },
     "msg": {
      "title": "Message",
      "type": "string"
     },
     "type": {
      "title": "Error Type",
      "type": "string"
     }
    },
    "required": [
     "loc",
     "msg",
     "type"
    ],
    "title": "ValidationError",
    "type": "object"
   }
  },
  "securitySchemes": {
   "HTTPBearer": {
    "scheme": "bearer",
    "type": "http"
   }
  }
 },
 "info": {
  "description": "Multi-agent scientific reasoning system with full provenance traceability",
  "title": "Aletheia",
  "version": "0.1.0"
 },
 "openapi": "3.1.0",
 "paths": {
  "/batch/debate": {
   "post": {
    "description": "Submit multiple claims for batch debate processing.",
    "operationId": "batch_debate_batch_debate_post",
    "requestBody": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/BatchRequest"
       }
      }
     },
     "required": true
    },
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/BatchJobResponse"
        }
       }
      },
      "description": "Successful Response"
     },
     "422": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      },
      "description": "Validation Error"
     }
    },
    "security": [
     {
      "HTTPBearer": []
     }
    ],
    "summary": "Batch Debate",
    "tags": [
     "batch"
    ]
   }
  },
